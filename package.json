{
  "name": "gatehouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find, check and let in agentic websites.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentic-web-check": "./cli/agentic-web-check.mjs"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node cli/agentic-web-check.mjs",
    "crawl": "node scripts/crawl.mjs",
    "build": "node scripts/snapshot.mjs && node vendor/agentify-website/scripts/build_network.mjs site/gatehouse.hocon --manifest site/agent-manifest.json",
    "serve": "node vendor/agentify-website/scripts/serve_site.mjs site --port 8080 --open-as 127.0.0.1"
  }
}
